{
	"schemaVersion": 1,
	"id": "pvpcrosshair",
	"version": "${version}",
	"name": "PvP Crosshair",
	"description": "Lightweight customizable PvP crosshair with entity and shield detection.",
	"authors": [
		"CoresCode"
	],
	"contact": {
		"homepage": "https://github.com/CoresCode/PvPCrosshair",
		"sources": "https://github.com/CoresCode/PvPCrosshair",
		"issues": "https://github.com/CoresCode/PvPCrosshair/issues"
	},
	"license": "MIT",
	"icon": "assets/pvpcrosshair/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.corescode.pvpcrosshair.client.PvPCrosshairClient"
		],
		"modmenu": [
			"com.corescode.pvpcrosshair.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "pvpcrosshair.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}
